<body class="hold-transition register-page">
<div class="register-box">
  @* <div class="register-logo">
    <a href="../../index2.html"><b>Admin</b>LTE</a>
  </div> *@

  <div class="card">
    <div class="card-body register-card-body">
      <p class="login-box-msg">    
        <a href="/Index"><b>ADM</b></a>
</p>

      <form action="../../index.html" method="post">
        <div class="input-group mb-3">
          <input type="text" asp-for="person.F_NAME" required class="form-control" required minlength="3" placeholder="Nombre">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-user"></span>
            </div>
          </div>
        </div>
        <div class="input-group mb-3">
          <input type="text" asp-for="person.F_LASTN" required class="form-control" required minlength="3" placeholder="Apellido">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-user"></span>
            </div>
          </div>
        </div>
        <div class="input-group mb-3">
          <input type="email" asp-for="auth.EMAIL" class="form-control" required minlength="3" placeholder="Email">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-envelope"></span>
            </div>
          </div>
        </div>
        <div class="input-group mb-3">
          <input type="password" asp-for="auth.PASSWORD" class="form-control" required minlength="8" placeholder="Contraseña">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-lock"></span>
            </div>
          </div>
        </div>
        <div class="input-group mb-3">
          <input type="password" asp-for="psw" class="form-control" required minlength="8" placeholder="Repetir contraseña">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-lock"></span>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-8">
            <div class="icheck-primary">
              <input type="checkbox" id="agreeTerms" name="terms" value="agree">
              <label for="agreeTerms">
               Asepto los terminos y condiciones <a href="#">Terminos</a>
              </label>
            </div>
          </div>
          <!-- /.col -->
          <div class="col-4">
            <button type="submit" class="btn btn-primary btn-block">Regiatrar</button>
          </div>
          <!-- /.col -->
        </div>
      </form>

      @* <div class="social-auth-links text-center">
        <p>- OR -</p>
        <a href="#" class="btn btn-block btn-primary">
          <i class="fab fa-facebook mr-2"></i>
          Sign up using Facebook
        </a>
        <a href="#" class="btn btn-block btn-danger">
          <i class="fab fa-google-plus mr-2"></i>
          Sign up using Google+
        </a>
      </div> *@

      <a asp-page="/Account/Login" class="text-center">Ya tengo una cuenta</a>
    </div>
    <!-- /.form-box -->
  </div><!-- /.card -->
</div>
<!-- /.register-box -->


</body>
@page
@model NetEmployee.Pages.IndexModel

@using NetEmployee.Data
@using System.Security.Claims
@inject AccountController _ctr
@inject DataServices _data
@{
    ViewData["Title"] = "Home page";
}

@inject DataServices _data
@inject AccountController _ctr
@{
    var institution = User.FindFirst(ClaimTypes.Hash)?.Value;
    var code = User.FindFirst(ClaimTypes.Actor)?.Value;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var team = Request.Cookies["team"];
    
    //current date
    DateTime date_ = DateTime.Now;
    string date = date_.ToString("MM/dd/yyyy");
    string fname="";
    string flastname = "";
    int online = 0;
    int offline = 0;



 
}


<div class="text-center">
    <h1 class="display-4">Bienvenido @Request.Cookies["fname"]!</h1>
    <p>@Request.Cookies["positionName"]</p>
</div>


@ViewData["InstitutionName"]
<br />

   <section class="content">
      <div class="container-fluid">

@{
  if(int.Parse(role) >= 4){

        <div class="row">
          <div class="col-md-3 col-sm-6 col-12">

   
          @try{
             @foreach (var i in _data.ILoadAllUserByUIDINS(int.Parse(team),institution))
                                                    {
                                                        foreach (var t in _data.TrackUserHavailability(institution, date))
                                                        {
                                                            switch (t.STATE)
                                                            {
                                                                 
                                                                case "BREAK":
                                                                    offline += 1;
                                                                    
                                                                    
                                                                    break;
                                                                case "LUNCH":
                                                                offline += 1;
                                                                    
                                                                    break;
                                                                case "OTHER":
                                                                offline += 1;
                                                                   
                                                                    break;
                                                                case "END":
                                                                offline += 1;
                                                                    
                                                                    break;
                                                                case "READY":
                                                                online += 1;
                                                                   
                                                                    break;
                            
                                                            }
                                                            
                                                        }
                                                         
                                                    }
          }catch(Exception e){

          }                              
                                                    
                          
        
                        


            <div class="info-box">
              <span class="info-box-icon bg-info"><i class="fa-solid fa-user-clock"></i></span>

              <div class="info-box-content">
                <span class="info-box-text">Offline</span>
                <span class="info-box-number"> @offline</span>
              </div>
              <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
          </div>
          <!-- /.col -->
          <div class="col-md-3 col-sm-6 col-12">
            <div class="info-box">
              <span class="info-box-icon bg-success"><i class="fa-solid fa-user-check"></i></span>

              <div class="info-box-content">
                <span class="info-box-text">Online</span>
                <span class="info-box-number"> @online</span>
              </div>
              <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
          </div>
          <!-- /.col -->
          <div class="col-md-3 col-sm-6 col-12">
            <div class="info-box">
              <span class="info-box-icon bg-warning"><i class="fa-solid fa-user-injured"></i></span>

              <div class="info-box-content">
                <span class="info-box-text">Medical license</span>
                
                <span class="info-box-number">
                  @{
                    int med = 0;
                    try{
                      @foreach(var item in _data.LoadMedicalLicenseRegistryByTeam(institution,int.Parse(team))){
                        med += 1;
                      }
                    }catch(Exception e){

                    }
                  }
                    @med
                </span>
              </div>
              <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
          </div>
          <!-- /.col -->
          <div class="col-md-3 col-sm-6 col-12">
            <div class="info-box">
              <span class="info-box-icon bg-danger"><i class="fa-solid fa-user-xmark"></i></span>

              <div class="info-box-content">
                <span class="info-box-text">Absent <a data-bs-toggle="modal" href="#AbsenceReport">Report</a></span>
                @{ 
                  int AbsenceCount =0;
                  try{
                    foreach(var item in _data.LoadTeamMembers(institution,int.Parse(team))){
                      foreach(var i in _data.LoadAbsences(institution, item.CODE, date)){
                        AbsenceCount +=1;
                      }
                      
                    }
                  }catch(Exception e){

                  }
                }
                
                <span class="info-box-number">@AbsenceCount</span>
              </div>
              <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
          </div>
          <!-- /.col -->
        </div>

}
}


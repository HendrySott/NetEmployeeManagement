@page
@model NetEmployee.Pages.Payroll
@inject DataServices _data
@using System.Security.Claims
@using NetEmployee.Data
@{
  var institution = User.FindFirst(ClaimTypes.Hash)?.Value;
  var code = User.FindFirst(ClaimTypes.Actor)?.Value;
  var position_id = @Request.Cookies["positionId"];


    //current date
    DateTime date_ = DateTime.Now;
    string date = date_.ToString("MM/dd/yyyy");

    int cod = 0;
    int period =0;
    string sum = null;
    
    int h = 0;
    int m = 0;
    int s = 0;
                                          
    int count = 0;
    string sumTotalTime = null;
    float amount = 0;
    float hour = 0;
    double topay = 0;
    double value = 0;
    double addd = 0;
    double AFP = 2;
    double TAX = 15;
    double af = 0;
    double tax = 0;

    int month = 0;
    int day = 0;
    int year = 0;
    string tso = null;
    string fso = null;   
    string cdate = date;
    string[] words2 = cdate.Split('/');
                            
    month = Convert.ToInt32(words2[0]);
    day = Convert.ToInt32(words2[1]);
    year = Convert.ToInt32(words2[2]);
                          
    if (day >= 16)
    {
                              
      tso = year +"-"+ month+"-"+"15";
      fso = year +"-"+ month+"-"+"01";
                              
      period = 2;
    }
    else
    {
      month -= 1;
      tso = year+"-"+month +"-"+ "31";
      fso = year +"-"+ month+"-"+"16";
      period = 1;
    }

    
    foreach (var am in _data.GetWageById(institution,int.Parse(position_id)))
    {
      amount = @am.AMOUNT;
    }
    hour = amount / 12 / 2;
    
                          
                          
                              
    try
    {
      var bn = _data.GetBonusByUserID(institution, int.Parse(code));
      if (bn.Count() > 0)
      {
        foreach (var v in bn)
        { addd = v.AMOUNT; }
      }
      else
      { addd = 0;}
                                          
    }
    catch (Exception e)
    {
        Console.WriteLine(e);
        throw;
    }

  
}

